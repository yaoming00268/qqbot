{
  "manifest_version": 3,
  "name": "QQBot Gemini 连接",
  "version": "1.0.0",
  "description": "连接当前浏览器的 Gemini 登录态到本机 QQBot，免去手动复制 Cookie。",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://google.com/*", "https://gemini.google.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["http://127.0.0.1/*"], "js": ["connect.js"], "run_at": "document_idle"}]
}
